# ---------- Discord application (Developer Portal) ----------
# General Information > Application ID
DISCORD_CLIENT_ID=your_application_id_here
# Bot > Token
DISCORD_TOKEN=your_bot_token_here
# OAuth2 > Client Secret
DISCORD_CLIENT_SECRET=your_client_secret_here
# Must exactly match a Redirect added under OAuth2 > Redirects
REDIRECT_URI=http://localhost:3003/auth/callback

# ---------- Optional: upgrading from the single-server version ----------
# Waffle now works in any server. If you saved templates or vault items before that,
# put the ID of the server you used then here. On the first start they are moved to
# that server (and a backup is saved). You can delete this line afterwards.
# New installs do not need it.
# DISCORD_GUILD_ID=your_old_server_id_here

# ---------- Security ----------
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_random_secret_here
# Optional. By default this follows REDIRECT_URI: true when it starts with https://, otherwise false.
# COOKIE_SECURE=false
# Optional. How many web proxies sit in front of Waffle (hosting platforms and a
# reverse proxy that handles HTTPS count as 1). Default: 1 if REDIRECT_URI is https, else 0.
# TRUST_PROXY=0
# Comma-separated addresses the dashboard is opened from. When Waffle is public this
# is your site address, for example https://waffle.example.com (no path, no trailing slash).
ALLOWED_ORIGINS=http://localhost:3003,http://localhost:5173

# ---------- Server ----------
API_PORT=3003
# 127.0.0.1 = reachable from this computer only (Docker sets 0.0.0.0 itself)
API_HOST=127.0.0.1
# Optional: where the built dashboard lives (default: dashboard/dist)
# DASHBOARD_DIST=
